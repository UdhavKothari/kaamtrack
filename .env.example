# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OpenRouter key; the app only calls google/ models, pinned to Google infrastructure
OPENROUTER_API_KEY=

# Meta WhatsApp Cloud API (reminders). Test number + 24h token while building; use a System User token for permanent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name and language of the approved template (see README). Defaults: lot_reminder / en
WHATSAPP_TEMPLATE=lot_reminder
WHATSAPP_LANG=en
# Any long random text. Vercel Cron sends it so only Vercel can trigger the daily reminders.
CRON_SECRET=

# Upstash Redis REST credentials (Vercel > Storage > Upstash Redis fills these in on Vercel;
# copy the same two values here for local runs). KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

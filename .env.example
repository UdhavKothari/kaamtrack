# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OpenRouter key; the app only calls google/ models, pinned to Google infrastructure
OPENROUTER_API_KEY=

# Meta WhatsApp Cloud API (reminders). Test number + 24h token while building; use a System User token for permanent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Name and language of the approved template (see README). Defaults: lot_reminder / en
WHATSAPP_TEMPLATE=lot_reminder
WHATSAPP_LANG=en
# Any long random text. Vercel Cron sends it so only Vercel can trigger the daily reminders.
CRON_SECRET=

# Upstash Redis REST credentials (Vercel > Storage > Upstash Redis fills these in on Vercel;
# copy the same two values here for local runs). KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- WhatsApp conversation layer ---
# mock (default): simulated, nothing leaves the app. meta: real WhatsApp through Meta's Cloud API.
WHATSAPP_MODE=mock
# Webhook (Meta calls /api/whatsapp/webhook): the verify token you choose, and the Meta app's App Secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Owner passcode ---
# Leave empty to keep the board open. Set it to lock the board, uploads, reminders and simulator behind one passcode.

# Google sign-in for the owner side (Google Cloud > APIs & Services > Credentials > OAuth client, type Web).
# Redirect URIs: https://<your-site>/api/auth/google/callback and http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin Google accounts, comma-separated. They manage everyone else on the Settings page.
OWNER_EMAILS=

# AI: Gemini directly (preferred). If empty, OPENROUTER_API_KEY is used instead.
GEMINI_API_KEY=
